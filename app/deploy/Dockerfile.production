# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY app/web/package.json app/web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY app/web/ ./
RUN npm run build

FROM python:3.11-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/srv/app/src OTEL_SDK_DISABLED=true
WORKDIR /srv
COPY app/requirements/web.lock /srv/app/requirements/web.lock
RUN --mount=type=cache,target=/root/.cache/pip pip install --require-hashes -r app/requirements/web.lock \
    && groupadd --gid 10001 lensa && useradd --uid 10001 --gid 10001 --no-create-home lensa \
    && mkdir -p /srv/data/app /srv/data/processed && chown 10001:10001 /srv/data/app
COPY app/src/ /srv/app/src/
COPY app/config/ /srv/app/config/
COPY app/sql/ /srv/app/sql/
COPY --from=frontend /build/dist/ /srv/app/web/dist/
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/ready', timeout=4)"]
CMD ["uvicorn", "se2026.web.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log", "--proxy-headers"]
